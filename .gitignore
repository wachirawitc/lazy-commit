# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Editors and IDEs
.vs/
.vscode/
.idea/
*.suo
*.user
*.swp
*~
_ReSharper*/

# Claude Code local settings (personal, not shared)
.claude/settings.local.json

# graphify knowledge graph output
graphify-out/

# Skill eval runs: each run's scratch git repo is generated by the eval
# harness and must not be committed (git records it as a broken submodule)
lazy-commit-workspace/iteration-*/**/repo/

